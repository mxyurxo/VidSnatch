{
  "manifest_version": 3,
  "name": "VidSnatch",
  "short_name": "VidSnatch",
  "version": "1.1.0",
  "description": "Detect and download videos from any website — including HLS/TS streams. Fast, simple, reliable.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VidSnatch — Download Videos"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "tabs",
    "webRequest",
    "storage",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
